{
  "name": "@blog/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && pnpm run build:assets",
    "test": "vitest run",
    "test:unit": "vitest run lib scripts/generate-early-hints.test.mjs scripts/submit-indexnow-urls.test.mjs scripts/legacy-redirects.test.ts scripts/generate-rss.test.mjs scripts/precompress.test.mjs scripts/generate-sw.test.mjs",
    "test:early-hints": "vitest run scripts/generate-early-hints.test.mjs",
    "test:indexnow-submit": "vitest run scripts/submit-indexnow-urls.test.mjs",
    "test:redirects": "vitest run scripts/legacy-redirects.test.ts",
    "test:resource-hints": "vitest run scripts/resource-hints.test.mjs",
    "test:sw": "vitest run scripts/generate-sw.test.mjs",
    "test:theme": "vitest run lib/theme.test.ts",
    "generate:sw": "node scripts/generate-sw.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome lint .",
    "test:discovery": "vitest run lib/post-discovery.test.ts",
    "build:assets": "node scripts/generate-rss.mjs && node scripts/generate-llms.mjs && pagefind --site out --output-path out/_pagefind && next-sitemap --config next-sitemap.config.cjs && node scripts/verify-seo.mjs && node scripts/generate-early-hints.mjs && node scripts/generate-sw.mjs && node scripts/precompress.mjs"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@theguild/remark-mermaid": "0.3.0",
    "next": "16.0.7",
    "nextjs-toploader": "^3.9.17",
    "nextra": "4.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "baseline-browser-mapping": "^2.11.19",
    "next-sitemap": "4.2.3",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.125.0"
  }
}
