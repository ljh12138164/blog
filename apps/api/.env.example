DATABASE_URL=postgres://blog:blog-local@127.0.0.1:5432/blog
PORT=3001
HOST=127.0.0.1
# Run pnpm auth:setup to generate these two values. Do not use the placeholders.
JOURNAL_PASSWORD_HASH='replace-with-argon2id-hash'
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
