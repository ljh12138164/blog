DATABASE_URL=postgres://blog:blog-local@127.0.0.1:5432/blog
PORT=3001
HOST=127.0.0.1
# Generate a random secret; run pnpm db:migrate then pnpm auth:setup to save the password in PostgreSQL.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
