{
  "name": "@blog/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit.test.ts",
    "test:unit": "bun test test/unit.test.ts",
    "test:integration": "bun test --timeout 30000 test/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/database/migrate.ts",
    "auth:setup": "bun scripts/auth-setup.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/throttler": "^6.5.0",
    "cookie": "^1.0.2",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/express": "^5.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3"
  }
}
