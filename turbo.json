{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "SESSION_SECRET", "COOKIE_SECURE", "HOST", "PORT"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "dist/**",
        "public/feed.xml",
        "public/llms*.txt",
        "public/sw.js"
      ],
      "env": ["NODE_ENV"]
    },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["build"], "outputs": [], "cache": false },
    "test:unit": { "outputs": [], "cache": false }
  }
}
