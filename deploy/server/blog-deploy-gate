#!/bin/sh
set -eu

set -- ${SSH_ORIGINAL_COMMAND:-}

if [ "$#" -ne 2 ]; then
  echo "Only 'deploy' or 'deploy-api' with an immutable image tag is allowed." >&2
  exit 126
fi

if ! printf '%s\n' "$2" | grep -Eq '^sha-[0-9a-f]{40}$'; then
  echo "Invalid image tag." >&2
  exit 126
fi

case "$1" in
  deploy) exec sudo -n /usr/local/sbin/deploy-blog "$2" ;;
  deploy-api) exec sudo -n /usr/local/sbin/deploy-blog-api "$2" ;;
  *) echo "Unsupported deployment command." >&2; exit 126 ;;
esac
