#!/usr/bin/env bash
set -euo pipefail

STACK_DIR=/opt/stacks/blog
ENV_FILE="$STACK_DIR/.env"
HOST_NGINX_CONF=/www/server/panel/vhost/nginx/ai.ljhboard.cn.conf
NGINX_BIN=/www/server/nginx/sbin/nginx
NEW_TAG=${1:-}

if [[ $# -ne 1 || ! "$NEW_TAG" =~ ^sha-[0-9a-f]{40}$ ]]; then
  echo "Invalid image tag: $NEW_TAG" >&2
  exit 2
fi

exec 9>/run/lock/blog-deploy.lock
if ! flock -n 9; then
  echo "Another blog deployment is already running." >&2
  exit 3
fi

ARCHIVE=$(mktemp /tmp/blog-release.XXXXXX.tar.gz)
BUNDLE_DIR=$(mktemp -d /tmp/blog-release.XXXXXX)
cleanup() {
  rm -f "$ARCHIVE"
  rm -rf "$BUNDLE_DIR"
}
trap cleanup EXIT

cat > "$ARCHIVE"
tar -xzf "$ARCHIVE" -C "$BUNDLE_DIR"

for required in \
  image.tar \
  compose.yaml \
  deploy/host-nginx.conf \
  deploy/server/deploy-blog \
  deploy/server/blog-deploy-gate \
  deploy/server/blog-deploy.sudoers; do
  test -f "$BUNDLE_DIR/$required" || {
    echo "Release bundle is missing $required." >&2
    exit 2
  }
done

mkdir -p "$STACK_DIR/backups"
BACKUP_DIR="$STACK_DIR/backups/${NEW_TAG}-$(date -u +%Y%m%dT%H%M%SZ)"
PREVIOUS_TAG=$(sed -n 's/^IMAGE_TAG=//p' "$ENV_FILE" 2>/dev/null || true)
PREVIOUS_TAG=${PREVIOUS_TAG:-latest}

backup_file() {
  local source=$1
  local name=$2
  test -f "$source" || {
    echo "Required managed file is missing: $source" >&2
    exit 2
  }
  mkdir -p "$(dirname "$BACKUP_DIR/$name")"
  cp -p "$source" "$BACKUP_DIR/$name"
}

restore_file() {
  local name=$1
  local target=$2
  local mode=$3
  install -D -m "$mode" "$BACKUP_DIR/$name" "$target"
}

write_tag() {
  umask 077
  printf 'IMAGE_TAG=%s\n' "$1" > "$ENV_FILE.next"
  mv "$ENV_FILE.next" "$ENV_FILE"
}

is_healthy() {
  local attempt=0
  local page
  local canonical_pattern='<link rel="canonical" href="https://ljhboard\.cn"'
  # The previous release may still use the blog hostname during the domain migration.
  if [[ "${1:-}" == rollback ]]; then
    canonical_pattern='<link rel="canonical" href="https://(blog\.)?ljhboard\.cn"'
  fi
  page=$(mktemp)
  while [[ "$attempt" -lt 30 ]]; do
    if curl --fail --silent --show-error --max-time 3 http://127.0.0.1:18080/healthz >/dev/null \
      && curl --fail --silent --show-error --max-time 3 --output "$page" http://127.0.0.1:18080/ \
      && grep -Eq "$canonical_pattern" "$page" \
      && ! grep -Eq 'https?://([0-9]{1,3}\.){3}[0-9]{1,3}' "$page" \
      && curl --fail --silent --show-error --max-time 3 http://127.0.0.1:18080/posts/react-query-api-optimization >/dev/null; then
      rm -f "$page"
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  rm -f "$page"
  return 1
}

restore_previous_release() {
  restore_file compose.yaml "$STACK_DIR/compose.yaml" 644
  restore_file host-nginx.conf "$HOST_NGINX_CONF" 644
  restore_file deploy-blog /usr/local/sbin/deploy-blog 755
  restore_file blog-deploy-gate /usr/local/bin/blog-deploy-gate 755
  restore_file blog-deploy.sudoers /etc/sudoers.d/blog-deploy 440
  restore_file env "$ENV_FILE" 600
  "$NGINX_BIN" -t
  "$NGINX_BIN" -s reload
  (cd "$STACK_DIR" && docker compose up -d --remove-orphans web)
}

backup_file "$STACK_DIR/compose.yaml" compose.yaml
backup_file "$HOST_NGINX_CONF" host-nginx.conf
backup_file /usr/local/sbin/deploy-blog deploy-blog
backup_file /usr/local/bin/blog-deploy-gate blog-deploy-gate
backup_file /etc/sudoers.d/blog-deploy blog-deploy.sudoers
backup_file "$ENV_FILE" env

echo "Loading $NEW_TAG (previous: $PREVIOUS_TAG)"
docker load -i "$BUNDLE_DIR/image.tar"

install -m 644 "$BUNDLE_DIR/compose.yaml" "$STACK_DIR/compose.yaml"
install -m 644 "$BUNDLE_DIR/deploy/host-nginx.conf" "$HOST_NGINX_CONF"
install -m 755 "$BUNDLE_DIR/deploy/server/deploy-blog" /usr/local/sbin/deploy-blog
install -m 755 "$BUNDLE_DIR/deploy/server/blog-deploy-gate" /usr/local/bin/blog-deploy-gate
install -m 440 "$BUNDLE_DIR/deploy/server/blog-deploy.sudoers" /etc/sudoers.d/blog-deploy
write_tag "$NEW_TAG"

"$NGINX_BIN" -t
"$NGINX_BIN" -s reload
(cd "$STACK_DIR" && docker compose up -d --remove-orphans web)

if is_healthy; then
  echo "Deployment healthy: $NEW_TAG"
  exit 0
fi

echo "Health check failed; rolling back to $PREVIOUS_TAG" >&2
docker compose -f "$STACK_DIR/compose.yaml" logs --tail 80 web >&2 || true
restore_previous_release

if ! is_healthy rollback; then
  echo "Rollback health check also failed." >&2
  exit 5
fi

echo "Rolled back to $PREVIOUS_TAG" >&2
exit 4
