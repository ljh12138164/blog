#!/bin/sh
set -eu

STACK_DIR=/opt/stacks/blog
NEW_TAG=${1:-}

if [ "$#" -ne 1 ] || ! printf '%s\n' "$NEW_TAG" | grep -Eq '^sha-[0-9a-f]{40}$'; then
  echo "Invalid release tag: $NEW_TAG" >&2
  exit 2
fi

exec 9>/run/lock/blog-deploy.lock
if ! flock -n 9; then
  echo "Another blog deployment is already running." >&2
  exit 3
fi

cd "$STACK_DIR"

RELEASES_DIR="$STACK_DIR/releases"
CURRENT_LINK="$STACK_DIR/current"
RELEASE_DIR="$RELEASES_DIR/$NEW_TAG"

is_healthy() {
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    if curl --fail --silent --show-error --max-time 3 http://127.0.0.1/healthz >/dev/null; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  return 1
}

mkdir -p "$RELEASES_DIR"
PREVIOUS_RELEASE=$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)
STAGING_DIR=$(mktemp -d "$RELEASES_DIR/.incoming.XXXXXX")
cleanup() { rm -rf "$STAGING_DIR"; }
trap cleanup EXIT

tar -xzf - -C "$STAGING_DIR"
test -f "$STAGING_DIR/index.html"
test -f "$STAGING_DIR/_pagefind/pagefind.js"
test -f "$STAGING_DIR/sitemap.xml"
test -f "$STAGING_DIR/robots.txt"

if [ ! -d "$RELEASE_DIR" ]; then
  mv "$STAGING_DIR" "$RELEASE_DIR"
  STAGING_DIR=''
fi

ln -s "$RELEASE_DIR" "$CURRENT_LINK.next"
mv -Tf "$CURRENT_LINK.next" "$CURRENT_LINK"

if is_healthy; then
  echo "Deployment healthy: $NEW_TAG"
  exit 0
fi

echo "Health check failed; rolling back to $PREVIOUS_RELEASE" >&2
if [ -z "$PREVIOUS_RELEASE" ]; then
  exit 4
fi
ln -s "$PREVIOUS_RELEASE" "$CURRENT_LINK.next"
mv -Tf "$CURRENT_LINK.next" "$CURRENT_LINK"

if ! is_healthy; then
  echo "Rollback health check also failed." >&2
  exit 5
fi

echo "Rolled back to $PREVIOUS_RELEASE" >&2
exit 4
