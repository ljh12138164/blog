{
  "name": "nextra-ai-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "update:skill": "git submodule update --remote utils",
    "postbuild": "node scripts/generate-llms.mjs && pagefind --site out --output-path out/_pagefind && next-sitemap --config next-sitemap.config.cjs && node scripts/verify-seo.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome lint .",
    "check:write": "biome check --write .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@theguild/remark-mermaid": "0.3.0",
    "next": "16.0.7",
    "nextra": "4.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "baseline-browser-mapping": "^2.11.19",
    "lint-staged": "^17.4.1",
    "next-sitemap": "4.2.3",
    "pagefind": "1.5.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "packageManager": "pnpm@9.12.3"
}
