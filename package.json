{
  "name": "nextra-ai-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:blog": "turbo run dev --filter=@blog/web",
    "dev:api": "turbo run dev --filter=@blog/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @blog/api test:integration",
    "test:early-hints": "pnpm --filter @blog/web test:early-hints",
    "test:indexnow-submit": "pnpm --filter @blog/web test:indexnow-submit",
    "test:redirects": "pnpm --filter @blog/web test:redirects",
    "test:resource-hints": "pnpm --filter @blog/web test:resource-hints",
    "test:theme": "pnpm --filter @blog/web test:theme",
    "test:sw": "pnpm --filter @blog/web test:sw",
    "generate:sw": "pnpm --filter @blog/web generate:sw",
    "verify:seo": "pnpm --filter @blog/web verify:seo",
    "update:skill": "git submodule update --remote utils",
    "db:generate": "pnpm --filter @blog/api db:generate",
    "db:migrate": "pnpm --filter @blog/api db:migrate",
    "auth:setup": "pnpm --filter @blog/api auth:setup",
    "check": "biome lint .",
    "check:write": "biome check --write .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "2.11.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
