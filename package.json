{
  "name": "nextra-ai-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "update:skill": "git submodule update --remote utils",
    "postbuild": "node scripts/generate-llms.mjs && pagefind --site out --output-path out/_pagefind && next-sitemap --config next-sitemap.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.0.7",
    "nextra": "4.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "next-sitemap": "4.2.3",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.3"
}
